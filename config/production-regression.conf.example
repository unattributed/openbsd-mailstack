# Observed mail.blackbagsecurity.com regression profile, 2026-06-28.
# This file contains no credentials, private addresses, or dynamic WAN address.

EXPECTED_OPENBSD_RELEASE="7.9"
EXPECTED_SERVICES="postfix dovecot rspamd nginx mysqld redis sogod php83_fpm clamd freshclam unbound vultr_ddns osmap_serve osmap_mailbox_helper"
FORBIDDEN_ACTIVE_SERVICES="smtpd nsd unwind"
EXPECTED_TCP_PORTS="25 80 443 465 587 993 11334"
EXPECTED_LOOPBACK_ONLY_TCP_PORTS="8080"
MAIL_HOSTNAME="mail.blackbagsecurity.com"
DDNS_SERVICE="vultr_ddns"
DDNS_PROGRAM="/usr/local/sbin/vultr_ddns_multi.py"
OSMAP_HEALTH_PATH="/healthz"
OSMAP_LOGIN_PATH="/login"
